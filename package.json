{
  "name": "badligan",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "force:password": "node scripts/force-password.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start",
    "seed:badplatser": "node scripts/seed-badplatser.mjs",
    "seed:eea": "node scripts/seed-eea-bathing.mjs",
    "seed:naturist": "node scripts/seed-naturist-spots.mjs",
    "seed:osm": "node scripts/seed-osm-swimming.mjs",
    "update:temperatures": "node scripts/update-temperatures.mjs",
    "update:places-summary": "node scripts/update-places-summary.mjs",
    "scrub:place-legacy": "node scripts/scrub-place-legacy.mjs",
    "scrub:usernames": "node scripts/scrub-usernames.mjs",
    "backfill:scores": "node scripts/backfill-scores.mjs",
    "backfill:thumbnails": "node scripts/backfill-thumbnails.mjs",
    "backfill:toplist": "node scripts/backfill-toplist.mjs",
    "merge:places": "node scripts/merge-places.mjs",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest",
    "start": "next start"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^13.1.0",
    "glin-profanity": "^3.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.31.0",
    "next": "^16.3.4",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jimp": "^1.6.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": "prettier --check",
    "*.{ts,tsx}": [
      "oxlint",
      "bash -c 'tsc -b --noEmit'"
    ]
  },
  "allowScripts": {
    "@firebase/util": true,
    "fsevents": true,
    "protobufjs": true
  }
}
