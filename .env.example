# Set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1 to point at local emulators (default during dev).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1

# These are read at build time. Safe placeholders work for emulator-only dev.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# Use your Firebase Hosting domain (e.g. yourapp.web.app), NOT firebaseapp.com.
# This ensures the auth handler runs same-origin, avoiding cross-origin storage issues.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-badabadahavet.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-badabadahavet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-badabadahavet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional — enables Firebase Analytics in production-style builds.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional — Google Perspective API key for client-side moderation of names
# and notes (restrict it to the Comment Analyzer API + your domains, like the
# Firebase key). Empty = client-side checks are skipped; the logSession Cloud
# Function still enforces moderation via the PERSPECTIVE_API_KEY secret.
NEXT_PUBLIC_PERSPECTIVE_API_KEY=

# CARTO basemap API key — the map's tiles come from CARTO's raster basemaps,
# which watermark every tile ("API KEY REQUIRED") when the key is missing.
# Free up to 5M tile requests/month: https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=
