# Set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1 to point at local emulators (default during dev).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1

# These are read at build time. Safe placeholders work for emulator-only dev.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# Use your Firebase Hosting domain (e.g. yourapp.web.app), NOT firebaseapp.com.
# This ensures the auth handler runs same-origin, avoiding cross-origin storage issues.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-badabadahavet.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-badabadahavet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-badabadahavet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional — enables Firebase Analytics in production-style builds.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional, SERVER-ONLY — Google Perspective API key for text moderation.
# Read only in Route Handlers (src/server/moderate.ts): both the /api/moderate
# pre-check and the authoritative checks in /api/logSession,
# /api/updateSession and /api/setPlaceInfo. It is NOT NEXT_PUBLIC_, so it
# never reaches the browser. Empty = moderation is skipped entirely; the
# checks also fail open on API errors and timeouts, on purpose. In production
# this is an App Hosting secret (see apphosting.yaml). NOTE: the key must NOT
# carry an HTTP-referrer restriction — server-side calls send no referrer and
# Google rejects them with 403 API_KEY_HTTP_REFERRER_BLOCKED. Restrict it by
# API (Comment Analyzer) instead.
PERSPECTIVE_API_KEY=

# CARTO basemap API key — the map's tiles come from CARTO's raster basemaps,
# which watermark every tile ("API KEY REQUIRED") when the key is missing.
# Free up to 5M tile requests/month: https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=

# Server-side Firestore reads (the SSR'd spot page, /sitemap.xml and the
# /api/* route handlers) go through firebase-admin, which needs Application
# Default Credentials. Against the emulators nothing is required. Against a
# real project, point this at the same git-ignored service-account.json the
# maintenance scripts use; on App Hosting the runtime service account is
# picked up automatically and this must be left unset.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
